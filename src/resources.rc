#include "resource.h"

IDI_APP_ICON ICON "..\\assets\\printer.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,1,0,0
 PRODUCTVERSION 2,1,0,0
 FILEFLAGSMASK 0x3FL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "PrtEasyServer"
            VALUE "FileDescription", "PrtEasyServer - Windows Network Print Server"
            VALUE "FileVersion", "2.1.0.0"
            VALUE "InternalName", "PrtEasyServer-Custom"
            VALUE "LegalCopyright", "Copyright (C) 2024 PrtEasyServer - MIT License"
            VALUE "OriginalFilename", "PrtEasyServer-Custom.exe"
            VALUE "ProductName", "PrtEasyServer"
            VALUE "ProductVersion", "2.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
